# --- C++ build ---
build/
CMakeCache.txt
CMakeFiles/
compile_commands.json
*.o
*.obj
*.exe
*.a

# --- Editors / IDEs ---
.idea/
.vs/
.vscode/
.venv/

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Generated training data (large; regenerate locally) ---
*.csv
*.pt

# --- Downloaded assets ---
pieces/

# --- Terraform (cloud/terraform) ---
# Never commit provider caches or state; state can hold sensitive values and is
# environment-specific. The .example tfvars is tracked; real tfvars are not.
.terraform/
*.tfstate
*.tfstate.*
crash.log
terraform.tfvars
*.auto.tfvars
# Local provider mirror (large; regenerated with `terraform providers mirror`)
cloud/terraform*/mirror/
# Exported Windows/Norton CA bundle (machine-specific; regenerate per machine).
cloud/win-roots.pem
# Generated tablebases downloaded from S3 (~11 GB; regenerable on the GPU, not
# source). The engine loads them via CHESS_TB_DIR at runtime.
cloud/tables/
